# Copie este arquivo para .env e preencha com as chaves do projeto Supabase
# (Dashboard do Supabase → Settings → API). São chaves públicas (publishable),
# mas o .env real não é versionado por boa prática.
VITE_SUPABASE_PROJECT_ID="seu-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://seu-project-id.supabase.co"
